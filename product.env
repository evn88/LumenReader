# Название продукта — меняется здесь одной правкой (имя .app, bundle id, заголовки).
# README и Product.swift (fallback) берут его отсюда: scripts/rename.sh обновит их.
PRODUCT_NAME="Lumen Reader"
BUNDLE_ID="io.github.evn88.lumenreader"
VERSION="0.1"
# Страница поддержки (донат). Пусто — раздел поддержки в приложении скрыт.
SUPPORT_URL="https://github.com/sponsors/evn88"
# Автообновление (Sparkle). Лента — в GitHub Releases; позже можно переключить на сайт.
UPDATE_FEED_URL="https://github.com/evn88/LumenReader/releases/latest/download/appcast.xml"
# Публичный EdDSA-ключ. Приватный — только в Keychain (аккаунт = BUNDLE_ID) или в секрете CI, не в репозитории.
SPARKLE_PUBLIC_KEY="5PjO4qHSCd4sQHY4Fzfd+/c3ZOLvNtJHdd/7NNCXU8o="
